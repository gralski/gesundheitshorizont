  <script>
    const productReveal = document.querySelector('[data-product-reveal]');
    const showConversionElements = () => {
      document.documentElement.classList.add('v3-product-revealed');
    };

    if (!productReveal || !('IntersectionObserver' in window)) {
      showConversionElements();
    } else {
      const productObserver = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          showConversionElements();
          productObserver.disconnect();
        }
      }, { threshold: 0.18 });

      productObserver.observe(productReveal);
    }
  </script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = '5 Gründe, warum Frauen ab 35 ihre Beauty-Routine neu denken';
const description = 'Ein gesponserter Beitrag über die tägliche Beauty-Routine und Derma Renew Komplex von Dermapuris.';
const heroImage = '/images/5-gruende-hero.png';
const offer = new URL('https://dermapuris.de/products/derma-renew-komplex');
offer.searchParams.set('utm_source', 'auramio');
offer.searchParams.set('utm_medium', 'advertorial');
offer.searchParams.set('utm_campaign', 'fuenf_gruende_ab_35');
const offerLink = (placement: string) => {
  const url = new URL(offer);
  url.searchParams.set('utm_content', placement);
  return url.href;
};

const ingredients = [
  ['Fisch-Kollagen Peptan® F', '400 mg', 'Teil der Rezeptur für die tägliche Ergänzung.'],
  ['Hyaluronsäure', '97,1 mg', 'Ein bekannter Bestandteil in Beauty-Routinen.'],
  ['MSM', '200 mg', 'Ergänzt die Kombination der Inhaltsstoffe.'],
  ['Sägepalme 20:1', '200 mg', 'Pflanzlicher Bestandteil der Formel.'],
  ['Schachtelhalm-Extrakt', '40 mg', 'Enthält von Natur aus Kieselsäure.'],
  ['Wilde Yamswurzel', '100 mg', 'Pflanzlicher Bestandteil der Rezeptur.'],
];
---

<BaseLayout title={title} description={description} image={heroImage}>
  <article class="five-reasons">
    <div class="ad-note">Anzeige - Gesponserter Beitrag für Dermapuris</div>

    <header class="article-hero">
      <div class="hero-copy">
        <p class="topic">Beauty &amp; Wohlbefinden</p>
        <h1>Beauty-Routine ab 35 neu denken</h1>
        <p class="standfirst">Fünf Gedanken für alle, die sich eine einfache Ergänzung zu ihrer täglichen Pflege wünschen.</p>
        <div class="article-meta">
          <img src="/images/stephanm.webp" alt="Redaktion Auramio" width="46" height="46" />
          <div><strong>Auramio Redaktion</strong><span>Aktualisiert am 10. Oktober 2026</span></div>
          <span class="read-time">6 Minuten Lesezeit</span>
        </div>
      </div>
      <figure class="hero-image">
        <img src={heroImage} alt="Frau betrachtet sich entspannt in einem hellen Badezimmerspiegel" width="1536" height="1024" fetchpriority="high" />
        <figcaption>Eine Beauty-Routine darf einfach sein und sich gut in den Alltag einfügen. Symbolbild, KI-generiert.</figcaption>
      </figure>
    </header>

    <div class="article-content">
      <section class="opening">
        <p class="lead">Ich war die Frau, die alles ausprobiert hat: Retinol-Seren, Nachtcremes, Vitamin-C-Seren. Der Badezimmerschrank war voll, doch die Routine fühlte sich immer weniger nach einer Entscheidung an, die wirklich zu mir passte.</p>
        <p>Mit 42 sagte eine gute Freundin zu mir: Pflege von außen hat ihren Platz. Gleichzeitig lohnt sich auch ein Blick auf Ernährung, Alltag und die Frage, wie unkompliziert eine Routine dauerhaft sein kann.</p>
        <p>Später stieß ich auf Derma Renew Komplex von Dermapuris, ein Nahrungsergänzungsmittel mit Kollagen, Hyaluronsäure sowie weiteren Inhaltsstoffen. Ich war skeptisch, aber neugierig. Diese fünf Punkte haben mich dazu gebracht, die Produktinformationen genauer anzusehen.</p>
      </section>

      <section class="reason reason-one">
        <div class="reason-number" aria-hidden="true">01</div>
        <div class="reason-body">
          <p class="section-topic">Der Blick auf die Routine</p>
          <h2>Weil Pflege von außen nicht alles sein muss</h2>
          <p>Reinigung, Feuchtigkeit und Sonnenschutz bleiben wichtig. Haut ist aber auch Teil des Körpers. Wer seine Routine neu sortiert, beschäftigt sich deshalb oft zusätzlich mit Ernährung und ausgewählten Nährstoffen.</p>
          <p>Derma Renew Komplex kombiniert laut Hersteller unter anderem 400 mg hydrolysiertes Fisch-Kollagen, 97,1 mg Hyaluronsäure und 200 mg MSM pro Tagesportion. Die vollständige Zusammensetzung und Verzehrempfehlung stehen auf der Produktseite.</p>
          <p class="takeaway"><strong>Gedanke zum Mitnehmen:</strong> Eine gute Routine kann aus Pflege von außen und einem bewussten Blick auf die tägliche Ernährung bestehen.</p>
        </div>
        <figure class="reason-photo">
          <img src="/images/hautaerztin/mechanism.jpg" alt="Illustration zur Verbindung von Hautpflege und Nährstoffen" width="1200" height="896" loading="lazy" />
        </figure>
      </section>

      <section class="reason reason-two">
        <figure class="wide-photo">
          <img src="/images/mit-47/v2/morning-routine.webp" alt="Frau nimmt sich am Morgen Zeit für eine einfache Routine" width="1536" height="1024" loading="lazy" />
        </figure>
        <div class="reason-intro">
          <div class="reason-number" aria-hidden="true">02</div>
          <div>
            <h2>Weil sich eine Routine nur im Alltag beweisen kann</h2>
            <p>Viele Beauty-Produkte versprechen einen festen Zeitpunkt für sichtbare Veränderungen. Derma Renew kommuniziert eine tägliche Einnahme von zwei Kapseln zu einer Mahlzeit. Persönliche Erfahrungen können dabei sehr unterschiedlich sein.</p>
          </div>
        </div>
        <div class="report-box">
          <p>Der Anbieter verweist auf eine interne Befragung von 187 Anwenderinnen. Diese Angaben sind Erfahrungswerte und keine Garantie für ein bestimmtes Ergebnis.</p>
          <div class="report-grid">
            <div><strong>94 %</strong><span>berichteten von vitaler wirkender Haut</span></div>
            <div><strong>88 %</strong><span>nannten eine wahrgenommene Veränderung der Hautstruktur</span></div>
            <div><strong>83 %</strong><span>beschrieben ihr Hautbild als strahlender</span></div>
          </div>
        </div>
      </section>

      <section class="reason reason-three">
        <div class="reason-heading">
          <div class="reason-number" aria-hidden="true">03</div>
          <div>
            <p class="section-topic">Die Rezeptur</p>
            <h2>Weil transparente Angaben die Entscheidung leichter machen</h2>
            <p>Die Rezeptur bündelt acht Zutaten und Vitamine. Statt einer langen Zutatenliste stehen die wichtigsten Bestandteile mit ihren Mengen direkt nebeneinander.</p>
          </div>
        </div>
        <div class="formula-layout">
          <div class="ingredient-grid">
            {ingredients.map(([name, amount, detail]) => (
              <div class="ingredient"><span>{amount}</span><h3>{name}</h3><p>{detail}</p></div>
            ))}
          </div>
          <figure class="product-photo">
            <img src="/images/dermarenew-pal.webp" alt="Derma Renew Komplex in einem braunen Glasflakon" width="1074" height="1074" loading="lazy" />
          </figure>
        </div>
        <p class="formula-note">Die Formel enthält Fisch-Kollagen und ist daher nicht vegan. Angaben zu Allergenen, Zutaten und Verzehr finden Sie in der aktuellen Produktinformation des Herstellers.</p>
      </section>

      <section class="reason reason-four">
        <div class="cost-copy">
          <div class="reason-number" aria-hidden="true">04</div>
          <p class="section-topic">Der Kostencheck</p>
          <h2>Weil eine kürzere Routine auch weniger Entscheidungen bedeutet</h2>
          <p>Serum am Morgen, Nachtcreme, Augenpflege und gelegentliche Behandlungen können sich über das Jahr summieren. Was sinnvoll ist, bleibt immer persönlich. Trotzdem kann es hilfreich sein, die eigene Routine einmal ehrlich aufzuschreiben.</p>
          <p>Ein Glas Derma Renew Komplex enthält laut Hersteller 60 Kapseln. Aktuelle Preise, Paketoptionen, Versandkosten und Bedingungen stehen direkt im Dermapuris-Shop.</p>
          <a class="text-link" href={offerLink('cost_check')} rel="sponsored">Aktuelle Produktinformationen ansehen <span aria-hidden="true">→</span></a>
        </div>
        <figure>
          <img src="/images/advertorial-v3/hero-frau-am-handy.webp" alt="Frau informiert sich in Ruhe über ihre Beauty-Routine" width="1800" height="1200" loading="lazy" />
        </figure>
      </section>

      <section class="reason reason-five">
        <div class="reason-number" aria-hidden="true">05</div>
        <div class="guarantee-content">
          <div>
            <p class="section-topic">Die Entscheidung</p>
            <h2>Weil faire Bedingungen Sicherheit geben können</h2>
            <p>Dermapuris informiert auf der offiziellen Produktseite über eine 90-Tage-Geld-zurück-Garantie. Bevor Sie bestellen, prüfen Sie bitte die dort genannten, aktuell gültigen Bedingungen.</p>
            <p>Bei Allergien, Vorerkrankungen, Schwangerschaft, Stillzeit oder der Einnahme von Medikamenten sollte die Anwendung vorab ärztlich abgeklärt werden.</p>
            <p class="takeaway"><strong>Gedanke zum Mitnehmen:</strong> Informierte Entscheidungen beginnen mit der vollständigen Produktinformation und der eigenen gesundheitlichen Situation.</p>
          </div>
          <figure>
            <img src="/images/hautaerztin/final-product.jpg" alt="Derma Renew Komplex Produktflakon in einer hellen Umgebung" width="1200" height="896" loading="lazy" />
          </figure>
        </div>
      </section>

      <section class="closing">
        <div>
          <p class="section-topic">Der nächste Schritt</p>
          <h2>Eine Routine, die zu Ihnen passt</h2>
          <p>Wenn Sie sich in der Suche nach einer einfacheren Beauty-Routine wiedererkennen, finden Sie beim Hersteller die vollständige Rezeptur, Einnahmehinweise und das aktuelle Angebot.</p>
          <a class="primary-cta" href={offerLink('closing_cta')} rel="sponsored">Derma Renew beim Hersteller ansehen <span aria-hidden="true">→</span></a>
          <p class="cta-note">Alle Preise, Verfügbarkeit, Versand- und Garantiebedingungen im Dermapuris-Shop.</p>
        </div>
        <img src="/images/advertorial-v3/zwei-kapseln-routine.webp" alt="Zwei Kapseln neben einem Glas Wasser als Teil einer Morgenroutine" width="1500" height="1000" loading="lazy" />
      </section>

      <aside class="legal-note">
        <p><strong>Hinweis:</strong> Dieser Beitrag ist Werbung für Derma Renew Komplex von Dermapuris. Nahrungsergänzungsmittel sind kein Ersatz für eine ausgewogene, abwechslungsreiche Ernährung und eine gesunde Lebensweise. Individuelle Erfahrungen können variieren. Beachten Sie die Verzehrempfehlung und die Hinweise auf der aktuellen Produktverpackung.</p>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  :global(.five-reasons) { --ink:#18232c; --muted:#5c6b76; --teal:#0d9488; --teal-dark:#0f766e; --teal-wash:#effaf8; --line:#dce8e5; --surface:#f7fbfa; background:#fff; color:var(--ink); }
  .ad-note { background:#f4f7f6; border-bottom:1px solid var(--line); color:#66757d; font-size:11px; font-weight:700; letter-spacing:.08em; padding:9px 16px; text-align:center; text-transform:uppercase; }
  .article-hero { width:min(100% - 40px, 1160px); display:grid; grid-template-columns:minmax(0,.93fr) minmax(0,1.07fr); gap:clamp(32px,6vw,78px); align-items:center; margin:0 auto; padding:clamp(44px,7vw,82px) 0 clamp(54px,8vw,96px); }
  .hero-copy { padding-bottom:10px; }.topic,.section-topic { color:var(--teal-dark); font-size:12px; font-weight:800; letter-spacing:.09em; margin:0 0 13px; text-transform:uppercase; }.article-hero h1,.article-content h2,.ingredient h3 { color:var(--ink); letter-spacing:-.035em; text-wrap:balance; }.article-hero h1 { font-family:Georgia,Cambria,"Times New Roman",serif; font-size:clamp(2.35rem,5.1vw,4.35rem); font-weight:400; line-height:1.04; margin:0; }.standfirst { color:var(--muted); font-size:clamp(1.05rem,1.8vw,1.22rem); line-height:1.58; margin:23px 0 28px; max-width:44ch; }
  .article-meta { align-items:center; border-top:1px solid var(--line); display:flex; gap:12px; padding-top:18px; }.article-meta img { border-radius:50%; height:46px; object-fit:cover; width:46px; }.article-meta div { display:grid; gap:2px; font-size:13px; line-height:1.35; }.article-meta span { color:var(--muted); }.read-time { border-left:1px solid var(--line); margin-left:auto; padding-left:16px; white-space:nowrap; }.hero-image { margin:0; }.hero-image img { display:block; height:auto; width:100%; }.hero-image figcaption { color:var(--muted); font-size:12px; line-height:1.45; margin-top:9px; }
  .article-content { width:min(100% - 40px, 920px); margin:0 auto; padding-bottom:88px; }.opening { font-family:Georgia,Cambria,"Times New Roman",serif; max-width:690px; padding-bottom:48px; }.opening p,.reason p,.legal-note p { color:#34434c; font-size:clamp(1rem,1.6vw,1.1rem); line-height:1.76; }.opening p { margin:0 0 18px; }.lead { color:var(--ink)!important; font-size:clamp(1.2rem,2.4vw,1.48rem)!important; line-height:1.55!important; }
  .reason { margin-top:72px; }.reason-number { color:var(--teal); font-size:13px; font-weight:800; letter-spacing:.08em; line-height:1; }.reason h2 { font-family:Georgia,Cambria,"Times New Roman",serif; font-size:clamp(1.95rem,4vw,3.05rem); font-weight:400; line-height:1.08; margin:12px 0 22px; }.reason p { margin:0 0 18px; }.takeaway { background:var(--teal-wash); border-left:3px solid var(--teal); margin-top:28px!important; padding:17px 20px; }.reason-one { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(230px,.75fr); gap:clamp(30px,6vw,72px); align-items:start; }.reason-one .reason-number { grid-column:1; }.reason-one .reason-body { grid-column:1; }.reason-one .reason-photo { grid-column:2; grid-row:1 / span 2; margin:0; position:sticky; top:20px; }.reason-photo img { display:block; width:100%; }
  .reason-two { border-top:1px solid var(--line); padding-top:25px; }.wide-photo { margin:0 0 35px; }.wide-photo img,.reason-four figure img,.guarantee-content figure img { display:block; height:auto; width:100%; }.reason-intro { display:grid; grid-template-columns:70px 1fr; gap:14px; }.reason-intro h2 { margin-top:0; }.report-box { background:var(--surface); border:1px solid var(--line); margin-top:30px; padding:clamp(22px,4vw,36px); }.report-box > p { color:var(--muted); font-size:15px; margin-bottom:25px; max-width:70ch; }.report-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }.report-grid div { display:grid; gap:6px; }.report-grid strong { color:var(--teal-dark); font-family:Georgia,Cambria,"Times New Roman",serif; font-size:clamp(2rem,4vw,3.2rem); font-weight:400; letter-spacing:-.04em; line-height:1; }.report-grid span { color:#3c4c55; font-size:14px; line-height:1.42; }
  .reason-three { border-top:1px solid var(--line); padding-top:34px; }.reason-heading { display:grid; grid-template-columns:70px 1fr; gap:14px; max-width:750px; }.reason-heading h2 { margin-top:0; }.formula-layout { align-items:center; display:grid; grid-template-columns:1.2fr .8fr; gap:clamp(28px,5vw,64px); margin-top:30px; }.ingredient-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:12px; }.ingredient { background:#fff; border:1px solid var(--line); min-height:150px; padding:18px; }.ingredient span { color:var(--teal-dark); display:block; font-size:12px; font-weight:800; margin-bottom:12px; }.ingredient h3 { font-size:17px; font-weight:700; line-height:1.18; margin:0 0 9px; }.ingredient p { color:var(--muted); font-size:13px; line-height:1.42; margin:0; }.product-photo { background:var(--teal-wash); margin:0; padding:18px; }.product-photo img { display:block; height:auto; width:100%; }.formula-note { color:var(--muted)!important; font-size:14px!important; margin-top:20px!important; }
  .reason-four { align-items:center; background:var(--teal-wash); display:grid; grid-template-columns:1fr 1fr; gap:clamp(30px,5vw,64px); margin-left:calc((920px - 100vw) / 2); margin-right:calc((920px - 100vw) / 2); padding:clamp(44px,7vw,84px) max(20px, calc((100vw - 920px) / 2)); }.reason-four h2 { margin-top:12px; }.reason-four figure { margin:0; }.text-link { color:var(--teal-dark); display:inline-flex; font-weight:800; margin-top:8px; text-decoration:underline; text-decoration-color:#7bd3c9; text-decoration-thickness:2px; text-underline-offset:5px; }.text-link:hover { color:var(--ink); }
  .reason-five { border-top:1px solid var(--line); padding-top:34px; }.guarantee-content { display:grid; grid-template-columns:minmax(0,1fr) minmax(220px,.75fr); gap:clamp(28px,5vw,64px); margin-top:22px; }.guarantee-content figure { margin:0; }.closing { align-items:center; background:var(--ink); color:#fff; display:grid; grid-template-columns:1.1fr .9fr; gap:clamp(28px,5vw,64px); margin:80px 0 0; overflow:hidden; padding:clamp(30px,5vw,64px); }.closing .section-topic { color:#81d8cd; }.closing h2 { color:#fff; font-family:Georgia,Cambria,"Times New Roman",serif; font-size:clamp(2rem,4vw,3.15rem); font-weight:400; line-height:1.08; margin:10px 0 20px; }.closing p { color:#d6e1e1; font-size:17px; line-height:1.65; }.closing img { display:block; height:auto; width:100%; }.primary-cta { background:var(--teal); color:#fff; display:inline-flex; font-size:16px; font-weight:800; justify-content:center; margin-top:10px; padding:15px 20px; text-decoration:none; transition:background .2s,transform .2s; }.primary-cta:hover { background:#14b8a6; transform:translateY(-2px); }.primary-cta:active { transform:translateY(1px); }.cta-note { color:#aebfc0!important; font-size:13px!important; margin:13px 0 0!important; }.legal-note { border-top:1px solid var(--line); margin-top:52px; padding-top:25px; }.legal-note p { color:var(--muted); font-size:13px; line-height:1.65; }
  @media (max-width: 760px) { .article-hero { grid-template-columns:1fr; gap:32px; width:min(100% - 32px, 620px); padding-top:42px; }.article-content { width:min(100% - 32px, 920px); }.article-hero h1 { font-size:clamp(2.3rem,11vw,3.3rem); }.read-time { display:none; }.reason { margin-top:54px; }.reason-one,.formula-layout,.reason-four,.guarantee-content,.closing { grid-template-columns:1fr; }.reason-one .reason-photo { grid-column:1; grid-row:auto; position:static; }.reason-one .reason-body { grid-column:1; }.reason-intro,.reason-heading { grid-template-columns:44px 1fr; }.report-grid { grid-template-columns:1fr; gap:18px; }.report-grid div { grid-template-columns:100px 1fr; align-items:center; }.ingredient-grid { grid-template-columns:1fr; }.ingredient { min-height:0; }.reason-four { margin-left:-16px; margin-right:-16px; padding:42px 16px; }.closing { margin-top:56px; padding:30px; }.closing img { order:-1; }.guarantee-content figure { max-width:440px; }.article-meta { align-items:flex-start; }.article-meta div { padding-top:2px; } }
  @media (prefers-reduced-motion: reduce) { .primary-cta { transition:none; } }
</style>

<style>
  .derma-page {
    background: #fff;
  }

  /* Hero Section */
  .hero-section {
    background: #1e293b;
    color: #fff;
  }

  .hero-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    text-align: center;
  }

  .author-info {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #475569;
  }

  .author-name {
    font-size: 0.875rem;
    color: #cbd5e1;
    margin: 0;
  }

  .author-name strong {
    color: #fff;
  }

  .author-date {
    font-size: 0.75rem;
    color: #94a3b8;
    margin: 0;
  }

  .hero-title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1.5rem;
  }

  .hero-title .highlight {
    color: #0d9488;
  }

  .hero-description {
    font-size: 1.125rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .hero-image-wrapper {
    max-width: 600px;
    margin: 0 auto;
    border-radius: 12px;
    overflow: hidden;
  }

  .hero-image {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Main Content */
  .main-content {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  /* Intro Section */
  .intro-section {
    text-align: center;
    margin-bottom: 3rem;
  }

  .intro-quote {
    font-size: 1.25rem;
    font-style: italic;
    color: #374151;
    line-height: 1.7;
    margin: 0 0 1.5rem 0;
    padding: 0;
    border: none;
  }

  .intro-text {
    font-size: 1.125rem;
    color: #4b5563;
    margin: 0 0 1rem 0;
  }

  .intro-subtext {
    color: #6b7280;
    margin: 0;
  }

  /* Benefits Section */
  .benefits-section {
    background: linear-gradient(135deg, #f0fdfa 0%, #ccfbf1 100%);
    border-radius: 16px;
    padding: 2rem;
    margin-bottom: 4rem;
    text-align: center;
  }

  .benefits-section h2 {
    font-size: 1.5rem;
    color: #111827;
    margin: 0 0 1.5rem 0;
  }

  .benefits-list {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: left;
    max-width: 600px;
    margin: 0 auto;
  }

  .benefits-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    color: #374151;
  }

  .check {
    color: #0d9488;
    font-weight: 700;
    flex-shrink: 0;
  }

  .x {
    color: #dc2626;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Reason Sections */
  .reason-section {
    margin-bottom: 4rem;
  }

  .reason-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  .reason-image img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    display: block;
    max-height: 400px;
    object-fit: cover;
  }

  .reason-text h2 {
    font-size: 1.5rem;
    color: #111827;
    margin: 0 0 1rem 0;
    line-height: 1.3;
  }

  .reason-text p {
    color: #374151;
    line-height: 1.7;
    margin: 0 0 1rem 0;
  }

  .reason-text p:last-child {
    margin-bottom: 0;
  }

  .negative-list,
  .positive-list,
  .ingredient-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem 0;
  }

  .negative-list li,
  .positive-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    color: #374151;
  }

  .ingredient-list li {
    color: #374151;
    margin-bottom: 0.5rem;
    padding-left: 1rem;
    position: relative;
  }

  .ingredient-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #0d9488;
    font-weight: 700;

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePages } from '../site-pages';
---

<BaseLayout title="Seitenübersicht" description="Alle aktuell gebauten Artikel- und Advertorialseiten von Auramio auf einen Blick.">
  <section class="bg-gradient-to-br from-primary/10 via-white to-stone-50 py-14 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-primary text-sm font-semibold tracking-wide uppercase mb-3">Auramio</p>
      <h1 class="max-w-3xl text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-gray-900">Alle gebauten Seiten auf einen Blick</h1>
      <p class="max-w-2xl mt-5 text-lg leading-relaxed text-gray-600">Diese Übersicht ist der direkte Einstieg zum Prüfen aller aktuellen Artikel und Advertorials.</p>
    </div>
  </section>

  <section class="py-12 sm:py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8 flex items-center justify-between gap-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">{sitePages.length} Seiten</h2>
        <a href="/" class="text-sm font-semibold text-primary hover:text-primary/75">← Zur Startseite</a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sitePages.map((page) => (
          <article class="group overflow-hidden rounded-2xl border border-gray-200 bg-white transition duration-200 hover:-translate-y-1 hover:shadow-xl">
            <a href={page.href} class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">
              <img src={page.image} alt="" class="h-52 w-full object-cover" loading="lazy" />
              <div class="p-6">
                <span class="text-xs font-bold uppercase tracking-wider text-primary">{page.type}</span>
                <h3 class="mt-2 text-xl font-bold leading-snug text-gray-900 group-hover:text-primary">{page.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-gray-600">{page.description}</p>
                <span class="mt-5 inline-flex items-center text-sm font-semibold text-gray-900 group-hover:text-primary">Seite öffnen <span aria-hidden="true" class="ml-1">→</span></span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

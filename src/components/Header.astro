---
import { normalizeLocale } from '../i18n/locale';
import { ui } from '../i18n/ui';

interface Props {
  locale?: 'de' | 'fr';
}

const { locale: rawLocale = 'de' } = Astro.props;
const locale = normalizeLocale(rawLocale);
const t = ui[locale];
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/", label: t.nav.home },
  { href: "/seiten", label: t.nav.pages },
  { href: "/kategorie/gehirngesundheit", label: t.nav.brainHealth },
  { href: "/kategorie/ernaehrung", label: t.nav.nutrition },
  { href: "/kategorie/langlebigkeit", label: t.nav.longevity },
  { href: "/kategorie/forschung", label: t.nav.research },
];

// Only exact match or direct child path for active state
const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href + "/");
};
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap" rel="stylesheet" />

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="brand-mark" aria-label="Auramio - Startseite">
      <svg class="brand-symbol" viewBox="0 0 32 32" aria-hidden="true">
        <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="1.4" opacity=".35" />
        <circle cx="16" cy="16" r="9.5" fill="none" stroke="currentColor" stroke-width="1.4" opacity=".65" />
        <circle cx="16" cy="16" r="4.6" fill="currentColor" />
      </svg>
      <span class="brand-name">Auramio</span>
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      class="menu-toggle"
      aria-label={t.nav.openMenu}
      aria-controls="mobile-menu"
      aria-expanded="false"
      onclick="const m=document.getElementById('mobile-menu');const open=m.classList.toggle('is-open');this.setAttribute('aria-expanded', String(open));"
    >
      <span></span><span></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile Navigation">
    <ul>
      {navItems.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background: rgba(255, 255, 255, .96);
    border-bottom: 1px solid #ebe6de;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .site-header-inner {
    align-items: center;
    display: flex;
    gap: 32px;
    height: 68px;
    justify-content: space-between;
    margin: 0 auto;
    max-width: 1180px;
    padding: 0 24px;
  }

  .brand-mark {
    align-items: center;
    color: #16302e;
    display: inline-flex;
    flex-shrink: 0;
    gap: 10px;
    text-decoration: none;
  }

  .brand-symbol {
    color: #0e6b63;
    height: 26px;
    transition: transform .4s ease;
    width: 26px;
  }

  .brand-name {
    font-family: 'Newsreader', Georgia, 'Times New Roman', serif;
    font-size: 27px;
    font-weight: 500;
    letter-spacing: -.02em;
    line-height: 1;
    padding-bottom: 2px;
  }

  .brand-mark:hover .brand-symbol { transform: scale(1.06); }

  .site-nav ul {
    align-items: center;
    display: flex;
    gap: 30px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    color: #5b6564;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -.005em;
    padding: 24px 0;
    position: relative;
    text-decoration: none;
    transition: color .2s ease;
  }

  .site-nav a::after {
    background: #0e6b63;
    bottom: 16px;
    content: '';
    height: 1.5px;
    left: 0;
    position: absolute;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .25s ease;
    width: 100%;
  }

  .site-nav a:hover, .site-nav a[aria-current='page'] { color: #1b2324; }
  .site-nav a:hover::after, .site-nav a[aria-current='page']::after { transform: scaleX(1); }

  .menu-toggle {
    background: none;
    border: 0;
    cursor: pointer;
    display: none;
    flex-direction: column;
    gap: 6px;
    height: 40px;
    justify-content: center;
    margin-right: -8px;
    padding: 8px;
    width: 40px;
  }

  .menu-toggle span {
    background: #1b2324;
    border-radius: 2px;
    display: block;
    height: 1.5px;
    transition: transform .25s ease;
    width: 22px;
  }

  .menu-toggle[aria-expanded='true'] span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] span:last-child { transform: translateY(-3.75px) rotate(-45deg); }

  .mobile-menu { display: none; }

  @media (max-width: 860px) {
    .site-header-inner { height: 60px; padding: 0 16px; }
    .brand-symbol { height: 23px; width: 23px; }
    .brand-name { font-size: 24px; }
    .site-nav { display: none; }
    .menu-toggle { display: flex; }

    .mobile-menu.is-open { border-top: 1px solid #ebe6de; display: block; }
    .mobile-menu ul { list-style: none; margin: 0; padding: 8px 16px 16px; }
    .mobile-menu a {
      border-bottom: 1px solid #f1ede7;
      color: #333d3e;
      display: block;
      font-size: 16px;
      font-weight: 500;
      padding: 14px 0;
      text-decoration: none;
    }
    .mobile-menu li:last-child a { border-bottom: 0; }
    .mobile-menu a[aria-current='page'] { color: #0e6b63; }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-symbol, .site-nav a::after, .menu-toggle span { transition: none; }
  }
</style>

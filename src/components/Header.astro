---
import { normalizeLocale } from '../i18n/locale';
import { ui } from '../i18n/ui';

interface Props {
  locale?: 'de' | 'fr';
}

const { locale: rawLocale = 'de' } = Astro.props;
const locale = normalizeLocale(rawLocale);
const t = ui[locale];
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/", label: t.nav.home },
  { href: "/kategorie/gehirngesundheit", label: t.nav.brainHealth },
  { href: "/kategorie/ernaehrung", label: t.nav.nutrition },
  { href: "/kategorie/langlebigkeit", label: t.nav.longevity },
  { href: "/kategorie/forschung", label: t.nav.research },
];

// Only exact match or direct child path for active state
const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href + "/");
};
---

<header class="bg-white border-b border-gray-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-3">

      <!-- Logo - Left aligned -->
      <a href="/" class="brand-mark group flex-shrink-0 sm:-ml-20" aria-label="Auramio - Startseite">
        <span class="brand-symbol" aria-hidden="true">a</span>
        <span class="brand-name">auramio</span>
      </a>

      <!-- Desktop Navigation - Right aligned -->
      <nav class="hidden sm:block">
        <ul class="flex items-center space-x-6">
          {navItems.map((item) => (
            <li>
              <span
                class="text-sm font-medium transition-colors py-1 text-gray-600 hover:text-gray-900 cursor-pointer"
              >
                {item.label}
              </span>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Mobile Navigation Toggle -->
      <button
        type="button"
        class="sm:hidden text-gray-600 hover:text-primary p-1"
        aria-label={t.nav.openMenu}
        onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden sm:hidden pb-3">
      <ul class="space-y-1 border-t border-gray-100 pt-3">
        {navItems.map((item) => (
          <li>
            <span
              class="block px-3 py-2 text-sm font-medium rounded-lg transition-colors text-gray-600 hover:bg-gray-50 hover:text-gray-900 cursor-pointer"
            >
              {item.label}
            </span>
          </li>
        ))}
      </ul>
    </div>

  </div>
</header>

<style>
  .brand-mark {
    align-items: center;
    color: #162d33;
    display: inline-flex;
    gap: .48rem;
    text-decoration: none;
  }

  .brand-symbol {
    align-items: center;
    background: #0d9488;
    border-radius: 50%;
    color: #fff;
    display: inline-flex;
    font-family: Georgia, Cambria, 'Times New Roman', serif;
    font-size: 1.25rem;
    font-weight: 700;
    height: 1.72rem;
    justify-content: center;
    line-height: 1;
    transition: transform .2s ease, background-color .2s ease;
    width: 1.72rem;
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 750;
    letter-spacing: -.055em;
    line-height: 1;
  }

  .brand-mark:hover .brand-symbol {
    background: #0f766e;
    transform: translateY(-1px);
  }

  @media (min-width: 640px) {
    .brand-symbol {
      font-size: 1.55rem;
      height: 2.28rem;
      width: 2.28rem;
    }

    .brand-name {
      font-size: 1.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-symbol {
      transition: none;
    }
  }
</style>
